# Copy this file to .env and fill in your own Supabase project's values.
# Supabase dashboard → Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY is a *public* key — Supabase is designed to have it
# shipped in frontend code. Row Level Security policies (see
# supabase/migrations/0001_init.sql) are what actually keep data safe, not
# keeping this key secret.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables interview-room persistence in server/index.js (the
# live-interview relay), so a restart/redeploy (e.g. a free host sleeping
# after ~15 min idle) doesn't wipe in-progress interview rooms.
# Server-only: no VITE_ prefix, so Vite ignores these and they are never
# shipped to the browser. Same service-role convention as
# scripts/seed-problems.mjs — get this from Supabase dashboard → Project
# Settings → API → service_role secret. Leave unset for local dev; the
# server falls back to in-memory-only rooms with a console warning.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Optional — needed only for the admin-only AI-generated-code check
# (POST .../check-ai) and to verify a caller is really an admin before
# either that route or the similarity-check route will run. SUPABASE_ANON_KEY
# is NOT a secret — it's the exact same public value as VITE_SUPABASE_ANON_KEY
# above, just duplicated under a server-side name (server/index.js needs its
# own copy since Vite strips non-VITE_ vars from the browser bundle).
# ANTHROPIC_API_KEY IS a real secret — get it from console.anthropic.com.
# Leave both unset to keep interview History working with everything except
# the two AI-review buttons, which degrade to a clear 503 instead of erroring.
SUPABASE_ANON_KEY=your-anon-public-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — tells the deployed frontend (src/interview/interviewApi.js)
# where to reach the live-interview relay server (server/index.js), which
# runs as its own always-on process and can't be hosted on Vercel/GitHub
# Pages/Netlify alongside the static site. Leave unset for local dev — Vite's
# dev proxy (vite.config.js) already forwards /api/interviews and
# /ws/interview to http://localhost:8787 for you. Set this in your frontend
# host's environment variables (not this file) once server/index.js is
# deployed somewhere that runs persistent Node processes (e.g. Render).
VITE_INTERVIEW_SERVER_URL=https://your-relay-server.onrender.com
