# Copy this file to .env and fill in your own Supabase project's values.
# Supabase dashboard → Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY is a *public* key — Supabase is designed to have it
# shipped in frontend code. Row Level Security policies (see
# supabase/migrations/0001_init.sql) are what actually keep data safe, not
# keeping this key secret.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — enables interview-room persistence in server/index.js (the
# live-interview relay), so a restart/redeploy (e.g. a free host sleeping
# after ~15 min idle) doesn't wipe in-progress interview rooms.
# Server-only: no VITE_ prefix, so Vite ignores these and they are never
# shipped to the browser. Same service-role convention as
# scripts/seed-problems.mjs — get this from Supabase dashboard → Project
# Settings → API → service_role secret. Leave unset for local dev; the
# server falls back to in-memory-only rooms with a console warning.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
